# ==============================================================================
# CẤU HÌNH KẾT NỐI SUPABASE CLOUD DATABASE CHO BACKEND ERP
# ==============================================================================

PORT=5000

# 1. CHUỖI KẾT NỐI SUPABASE POSTGRESQL (Lấy từ Supabase: Project Settings -> Database)
#
# Đối với Transaction Pooler (Khuyên dùng khi chạy ứng dụng - cổng 6543):
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Đối với Direct Connection (Dùng cho Prisma Migration / db push - cổng 5432):
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. KHÓA BẢO MẬT & API SUPABASE (Lấy từ Supabase: Project Settings -> API)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. CẤU HÌNH NGÂN HÀNG THANH TOÁN VIETQR ĐỘNG
VIETQR_BANK_ID="970422" # MBBank (Mã định danh BIN Napas)
VIETQR_ACCOUNT_NO="0988889999"
VIETQR_ACCOUNT_NAME="NPP BANH KEO AN PHAT"

# 4. CẤU HÌNH GOOGLE SHEETS API (Nếu sử dụng đồng bộ)
