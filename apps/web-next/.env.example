# 1. Kết nối CSDL Supabase PostgreSQL qua Connection Pooler (Tối ưu cho Serverless trên Vercel)
# Lấy tại Supabase Dashboard -> Project Settings -> Database -> Connection string:
# Transaction pooler (Port 6543) dùng cho DATABASE_URL
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (Port 5432) dùng cho DIRECT_URL khi chạy prisma migrate/push
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. Thông tin Supabase API & Realtime / Storage
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# 3. Bảo mật JWT Token cho Auth
JWT_SECRET="fmcg_erp_dms_jwt_secret_anphat_2026_super_key_security"

# 4. Cấu hình Tài khoản Ngân hàng quét VietQR Động
VIETQR_BANK_ID="970422"
VIETQR_ACCOUNT_NO="0988889999"
VIETQR_ACCOUNT_NAME="NPP BANH KEO AN PHAT"
